DB_HOST=localhost
DB_PORT=5432
DB_NAME=abtagent_local
DB_USER=postgres
DB_PASSWORD=change-me
DB_SCHEMA=dbo

# Hub station codes confirmed from dbo.route and dbo.areamaster in abtagent_local.
