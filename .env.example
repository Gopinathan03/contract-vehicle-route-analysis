# LOAD_TO_CAPACITY_FACTOR=0.001

# These initial status bands are configurable operational defaults, not approved SLAs.
GOOD_UTILIZATION_MIN_PCT=70
ATTENTION_UTILIZATION_MIN_PCT=40
ATTENTION_MAX_TRAVEL_HOURS=12
POOR_MAX_TRAVEL_HOURS=18
